// Publish complete physical q/out rows after all tile inputs are finished.
.visible .entry eb_publish(
    .param .u32 n, .param .u64 q, .param .u64 out,
    .param .u64 work, .param .u32 steps)
{
    .reg .pred %p<4>;
    .reg .u32 %r<8>;
    .reg .u64 %a<8>;
    .reg .f64 %d<4>;
    ld.param.u32 %r0, [n];
    ld.param.u32 %r5, [steps];
    ld.param.u64 %a0, [q];
    ld.param.u64 %a1, [out];
    ld.param.u64 %a2, [work];
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %tid.x;
    mad.lo.u32 %r1, %r1, %r2, %r3;
    add.u32 %r1, %r1, 1;
    setp.gt.u32 %p0, %r1, %r0;
    @%p0 ret;
    mul.wide.u32 %a3, %r1, 8;
    add.u64 %a4, %a0, %a3;
