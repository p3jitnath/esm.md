// Copy only the distinct periodic ghosts, directly from their sole interiors.
// ABI nx,ny:u32 and q:u64. Launch 3*(2*(nx+2)+2*ny) threads before a batch.

.func (.param .b64 inverse) power2_inverse(.param .f64 divisor)
{
    .reg .pred %p<3>;
    .reg .b64 %v<4>;
    ld.param.b64 %v0, [divisor];
    and.b64 %v1, %v0, 0x800fffffffffffff;
    shr.u64 %v2, %v0, 52;
    and.b64 %v2, %v2, 2047;
    setp.eq.u64 %p0, %v1, 0;
    setp.ge.u64 %p1, %v2, 1;
    setp.le.u64 %p2, %v2, 2045;
    and.pred %p0, %p0, %p1;
    and.pred %p0, %p0, %p2;
    sub.u64 %v3, 2046, %v2;
    shl.b64 %v3, %v3, 52;
    selp.b64 %v3, %v3, 0, %p0;
    st.param.b64 [inverse], %v3;
    ret;
}

// Probe the actual inverse helper over CPU-generated rounding edge cases.
// ABI n,iterations:u32 and disjoint a,b,out:u64 with n FP64 values.
.visible .entry division_check(.param .u32 n, .param .u32 iterations,
    .param .u64 a, .param .u64 b, .param .u64 out)
{
    .reg .pred %p<2>;
    .reg .u32 %r<8>;
    .reg .u64 %v<8>;
    .reg .f64 %d<4>;
    .param .b64 inverse;
    .param .u32 valid;
    .param .f64 divisor;
    ld.param.u32 %r0, [n];
    ld.param.u64 %v0, [a];
    ld.param.u64 %v1, [b];
    ld.param.u64 %v2, [out];
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %tid.x;
    mad.lo.u32 %r1, %r1, %r2, %r3;
    setp.ge.u32 %p0, %r1, %r0;
    @%p0 ret;
    mul.wide.u32 %v3, %r1, 8;
    add.u64 %v4, %v0, %v3;
    add.u64 %v5, %v1, %v3;
    add.u64 %v6, %v2, %v3;
    ld.global.f64 %d0, [%v4];
    ld.global.f64 %d1, [%v5];
    st.param.f64 [divisor], %d1;
    call.uni (inverse), power2_inverse, (divisor);
    ld.param.b64 %v7, [inverse];
    mov.b64 %d2, %v7;
    setp.ne.u64 %p1, %v7, 0;
    @%p1 mul.rn.f64 %d3, %d0, %d2;
    @!%p1 div.rn.f64 %d3, %d0, %d1;
    st.global.f64 [%v6], %d3;
    ret;
}

.visible .entry sw_update_small_fused(
    .param .u32 nx, .param .u32 ny, .param .u64 q, .param .u64 base,
    .param .u64 out, .param .u64 work, .param .u64 par, .param .u32 final)
{
    .reg .pred %p<16>;
    .reg .pred %point_p0, %point_p1, %index_power2;
    .reg .u32 %index_mask, %index_test, %index_shift;
