    // SELF follows the accepted primitive_flux rounded dependencies.
    add.u64 %point_addr0, %a0, %a7;
    add.u64 %point_addr1, %point_addr0, %a5;
    add.u64 %point_addr2, %point_addr1, %a5;
    ld.global.f64 %point0, [%point_addr0];
    ld.global.f64 %point1, [%point_addr1];
    ld.global.f64 %point2, [%point_addr2];
    setp.eq.u32 %point_p0, %r10, 0;
    setp.eq.u32 %point_p1, %r10, 1;
    selp.f64 %d10, %point1, %point2, %point_p1;
    selp.f64 %d10, %point0, %d10, %point_p0;
