    // Boundary predicates identify the unique ghost replicas for this cell.
    setp.eq.u32 %p4, %r8, 1;
    setp.eq.u32 %p5, %r8, %r0;
    setp.eq.u32 %p6, %r7, 1;
    setp.eq.u32 %p7, %r7, %r1;
