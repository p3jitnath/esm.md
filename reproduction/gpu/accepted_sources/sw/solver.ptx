// Copy only the distinct periodic ghosts, directly from their sole interiors.
// ABI nx,ny:u32 and q:u64. Launch 3*(2*(nx+2)+2*ny) threads before a batch.
.visible .entry sw_edges(.param .u32 nx, .param .u32 ny, .param .u64 q)
