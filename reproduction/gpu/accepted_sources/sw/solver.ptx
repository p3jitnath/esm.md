    div.rn.f64 %point4, %point2, %point0;
    mul.rn.f64 %point5, %point15, %point0;
    sqrt.rn.f64 %point6, %point5;
    mul.rn.f64 %point7, %point5, %point0;
    mul.rn.f64 %point7, %point7, 0d3FE0000000000000;
