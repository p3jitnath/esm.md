SF_PRIVATE_SF_POINT_WEST_MX:
    mul.rn.f64 %point8, %point1, %point3;
    add.rn.f64 %point8, %point8, %point7;
    bra SF_PRIVATE_SF_POINT_WEST_READY;
SF_PRIVATE_SF_POINT_WEST_MASS:
    mov.f64 %point8, %point1;
SF_PRIVATE_SF_POINT_WEST_READY:
