    mul.lo.u32 %r5, %r2, 2;
    mul.lo.u32 %r6, %r1, 2;
    add.u32 %r6, %r6, %r5;
    mul.lo.u32 %r7, %r6, 3;
    mov.u32 %r8, %ctaid.x;
    mov.u32 %r9, %ntid.x;
    mov.u32 %r10, %tid.x;
