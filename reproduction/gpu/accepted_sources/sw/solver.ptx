    ld.param.u64 %a1, [base];
    ld.param.u64 %a2, [out];
    ld.param.u64 %a3, [work];
    ld.param.u64 %a4, [par];
    ld.param.u32 %r12, [final];
    add.u32 %r2, %r0, 2;
    add.u32 %r3, %r1, 2;
    mul.lo.u32 %r4, %r2, %r3;
    mul.lo.u32 %r5, %r0, %r1;
    mov.u32 %r6, %ctaid.x;
    mov.u32 %r7, %ntid.x;
    mov.u32 %r8, %tid.x;
    mad.lo.u32 %r6, %r6, %r7, %r8;
    setp.ge.u32 %p0, %r6, %r5;
    @%p0 ret;
    // Positive power-of-two widths use the accepted exact mask and shift.
    sub.u32 %index_mask, %r0, 1;
    and.b32 %index_test, %r0, %index_mask;
    setp.eq.u32 %index_power2, %index_test, 0;
