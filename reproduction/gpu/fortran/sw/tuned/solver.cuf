!> Fused GPU control for the ordered shallow-water stages and boundaries.
!! Flat FP64 arrays retain x-contiguous CPU field storage and SI parameter units.
module sw_gpu_optimised
  use cudafor
  implicit none
contains
  !> Copy each periodic ghost once before a nonempty batch of complete steps.
  attributes(global) subroutine sw_edges(nx,ny,q) bind(C,name='sw_edges')
    integer, value :: nx,ny
    real(8), device :: q(0:*)
    integer :: t,p,s,edge,a,z,i,j,ii,jj
    t=(blockidx%x-1)*blockdim%x+threadidx%x-1
    p=nx+2; s=p*(ny+2); edge=2*p+2*ny
    if(t>=3*edge) return
    a=t/edge; z=mod(t,edge)
    if(z<2*p) then
      i=mod(z,p); j=ny+1
      if(z<p) j=0
      ii=i
      if(i==0) ii=nx
      if(i==nx+1) ii=1
      jj=1
      if(j==0) jj=ny
    else
      i=nx+1
      if(z<2*p+ny) i=0
      j=mod(z-2*p,ny)+1; ii=1; jj=j
      if(i==0) ii=nx
    end if
    q(a*s+j*p+i)=q(a*s+jj*p+ii)
  end subroutine

  !> Copy every periodic face and corner directly from an interior cell.
  attributes(global) subroutine sw_halo(nx,ny,q) bind(C,name='sw_halo')
    integer, value :: nx,ny
    real(8), device :: q(0:*)
    integer :: t,p,s,a,j,i,jj,ii
    t=(blockidx%x-1)*blockdim%x+threadidx%x-1
    p=nx+2; s=p*(ny+2)
    if(t>=3*s) return
    a=t/s; j=mod(t,s)/p; i=mod(t,p)
    if(i>0.and.i<=nx.and.j>0.and.j<=ny) return
    ii=i; jj=j
    if(i==0) ii=nx
    if(i==nx+1) ii=1
    if(j==0) jj=ny
    if(j==ny+1) jj=1
    q(t)=q(a*s+jj*p+ii)
  end subroutine

  !> Evaluate D03 into five scratch fields after the input halo launch.
  attributes(global) subroutine sw_prepare_clean(nx,ny,q,work,par) bind(C,name='sw_prepare_clean')
    integer, value :: nx,ny
    real(8), device :: q(0:*),work(0:*),par(0:*)
    real(8) :: h,mx,my,u,v,z,c,pressure
    integer :: t,s,p,i,j,ii,jj,k
    t=(blockidx%x-1)*blockdim%x+threadidx%x-1
    s=(nx+2)*(ny+2)
    if(t>=s) return
    h=q(t); mx=q(s+t); my=q(2*s+t)
    u=mx/h; v=my/h; z=par(0)*h; c=sqrt(z); pressure=(z*h)*0.5_8
    work(t)=mx*u+pressure
    work(s+t)=mx*v
    work(2*s+t)=my*v+pressure
    work(3*s+t)=abs(u)+c
    work(4*s+t)=abs(v)+c
  end subroutine

  !> Return the exactly rounded D04 face with the left speed selected at a tie.
  attributes(device) real(8) function face(ql,qr,fl,fr,half_alpha)
    real(8), value :: ql,qr,fl,fr,half_alpha
    real(8) :: alpha,central,jump,dissipative
    central=(fl+fr)*0.5_8; jump=qr-ql; dissipative=half_alpha*jump
    face=central-dissipative
  end function

  !> Update all three fields of one cell; final=1 averages with the old state.
  attributes(global) subroutine sw_update(nx,ny,q,base,out,work,par,final) bind(C,name='sw_update')
    integer, value :: nx,ny,final
    real(8), device :: q(0:*),base(0:*),out(0:*),work(0:*),par(0:*)
    real(8) :: east,west,north,south,dx,dy,ell,e,fx0,fxe,fxw,fy0,fyn,fys
    real(8) :: inverse_x,inverse_y,ae,aw,an,ast
    integer :: t,p,s,i,j,k,a,b,sx,sy,ii,jj,xrep(3),yrep(3),xc,yc,xi,yj
    t=(blockidx%x-1)*blockdim%x+threadidx%x-1
    if(t>=nx*ny) return
    p=nx+2; s=p*(ny+2); i=mod(t,nx)+1; j=t/nx+1; k=j*p+i
    sx=3*s; sy=4*s
    xc=1; yc=1; xrep(1)=i; yrep(1)=j
    if(i==1) then
      xc=xc+1; xrep(xc)=nx+1
    end if
    if(i==nx) then
      xc=xc+1; xrep(xc)=0
    end if
    if(j==1) then
      yc=yc+1; yrep(yc)=ny+1
    end if
    if(j==ny) then
      yc=yc+1; yrep(yc)=0
    end if
    ae=work(sx+k+1); if(work(sx+k)>=ae) ae=work(sx+k)
    aw=work(sx+k); if(work(sx+k-1)>=aw) aw=work(sx+k-1)
    an=work(sy+k+p); if(work(sy+k)>=an) an=work(sy+k)
    ast=work(sy+k); if(work(sy+k-p)>=ast) ast=work(sy+k-p)
    ae=ae*0.5_8; aw=aw*0.5_8; an=an*0.5_8; ast=ast*0.5_8
    do a=0,2
      b=a*s+k
      if(a==0) then
        fx0=q(s+k); fxe=q(s+k+1); fxw=q(s+k-1)
        fy0=q(2*s+k); fyn=q(2*s+k+p); fys=q(2*s+k-p)
      else
        fx0=work((a-1)*s+k); fxe=work((a-1)*s+k+1); fxw=work((a-1)*s+k-1)
        fy0=work(a*s+k); fyn=work(a*s+k+p); fys=work(a*s+k-p)
      end if
      east=face(q(b),q(b+1),fx0,fxe,ae)
      west=face(q(b-1),q(b),fxw,fx0,aw)
      north=face(q(b),q(b+p),fy0,fyn,an)
      south=face(q(b-p),q(b),fys,fy0,ast)
      dx=(east-west)/par(1); dy=(north-south)/par(2)
      ell=-(dx+dy); e=q(b)+par(3)*ell
      if(final==0) then
        out(b)=e
      else
        out(b)=base(b)*0.5_8+e*0.5_8
      end if
      e=out(b)
      do yj=1,yc
        do xi=1,xc
          if(xi==1.and.yj==1) cycle
          out(a*s+yrep(yj)*p+xrep(xi))=e
        end do
      end do
    end do
  end subroutine
  !> Update one field per z block; final=1 averages with the old state.
  attributes(global) subroutine sw_update_small(nx,ny,q,base,out,work,par,final) bind(C,name='sw_update_small')
    integer, value :: nx,ny,final
    real(8), device :: q(0:*),base(0:*),out(0:*),work(0:*),par(0:*)
    real(8) :: east,west,north,south,dx,dy,ell,e,fx0,fxe,fxw,fy0,fyn,fys
    real(8) :: inverse_x,inverse_y,ae,aw,an,ast
    integer :: t,p,s,i,j,k,a,b,sx,sy,ii,jj,xrep(3),yrep(3),xc,yc,xi,yj
    t=(blockidx%x-1)*blockdim%x+threadidx%x-1
    if(t>=nx*ny) return
    p=nx+2; s=p*(ny+2); i=mod(t,nx)+1; j=t/nx+1; k=j*p+i
    sx=3*s; sy=4*s
    xc=1; yc=1; xrep(1)=i; yrep(1)=j
    if(i==1) then
      xc=xc+1; xrep(xc)=nx+1
    end if
    if(i==nx) then
      xc=xc+1; xrep(xc)=0
    end if
    if(j==1) then
      yc=yc+1; yrep(yc)=ny+1
    end if
    if(j==ny) then
      yc=yc+1; yrep(yc)=0
    end if
    ae=work(sx+k+1); if(work(sx+k)>=ae) ae=work(sx+k)
    aw=work(sx+k); if(work(sx+k-1)>=aw) aw=work(sx+k-1)
    an=work(sy+k+p); if(work(sy+k)>=an) an=work(sy+k)
    ast=work(sy+k); if(work(sy+k-p)>=ast) ast=work(sy+k-p)
    ae=ae*0.5_8; aw=aw*0.5_8; an=an*0.5_8; ast=ast*0.5_8
    do a=blockidx%z-1,blockidx%z-1
      b=a*s+k
      if(a==0) then
        fx0=q(s+k); fxe=q(s+k+1); fxw=q(s+k-1)
        fy0=q(2*s+k); fyn=q(2*s+k+p); fys=q(2*s+k-p)
      else
        fx0=work((a-1)*s+k); fxe=work((a-1)*s+k+1); fxw=work((a-1)*s+k-1)
        fy0=work(a*s+k); fyn=work(a*s+k+p); fys=work(a*s+k-p)
      end if
      east=face(q(b),q(b+1),fx0,fxe,ae)
      west=face(q(b-1),q(b),fxw,fx0,aw)
      north=face(q(b),q(b+p),fy0,fyn,an)
      south=face(q(b-p),q(b),fys,fy0,ast)
      dx=(east-west)/par(1); dy=(north-south)/par(2)
      ell=-(dx+dy); e=q(b)+par(3)*ell
      if(final==0) then
        out(b)=e
      else
        out(b)=base(b)*0.5_8+e*0.5_8
      end if
      e=out(b)
      do yj=1,yc
        do xi=1,xc
          if(xi==1.and.yj==1) cycle
          out(a*s+yrep(yj)*p+xrep(xi))=e
        end do
      end do
    end do
  end subroutine
  !> Update all three fields of one cell; final=1 averages with the old state.
  attributes(global) subroutine sw_update_medium(nx,ny,q,base,out,work,par,final) bind(C,name='sw_update_medium')
    integer, value :: nx,ny,final
    real(8), device :: q(0:*),base(0:*),out(0:*),work(0:*),par(0:*)
    real(8) :: east,west,north,south,dx,dy,ell,e,fx0,fxe,fxw,fy0,fyn,fys
    real(8) :: inverse_x,inverse_y,ae,aw,an,ast
    integer :: t,p,s,i,j,k,a,b,sx,sy,ii,jj,xrep(3),yrep(3),xc,yc,xi,yj
    i=(blockidx%x-1)*blockdim%x+threadidx%x; j=blockidx%y
    if(i>nx.or.j>ny) return
    p=nx+2; s=p*(ny+2); k=j*p+i
    sx=3*s; sy=4*s
    xc=1; yc=1; xrep(1)=i; yrep(1)=j
    if(i==1) then
      xc=xc+1; xrep(xc)=nx+1
    end if
    if(i==nx) then
      xc=xc+1; xrep(xc)=0
    end if
    if(j==1) then
      yc=yc+1; yrep(yc)=ny+1
    end if
    if(j==ny) then
      yc=yc+1; yrep(yc)=0
    end if
    ae=work(sx+k+1); if(work(sx+k)>=ae) ae=work(sx+k)
    aw=work(sx+k); if(work(sx+k-1)>=aw) aw=work(sx+k-1)
    an=work(sy+k+p); if(work(sy+k)>=an) an=work(sy+k)
    ast=work(sy+k); if(work(sy+k-p)>=ast) ast=work(sy+k-p)
    ae=ae*0.5_8; aw=aw*0.5_8; an=an*0.5_8; ast=ast*0.5_8
    do a=0,2
      b=a*s+k
      if(a==0) then
        fx0=q(s+k); fxe=q(s+k+1); fxw=q(s+k-1)
        fy0=q(2*s+k); fyn=q(2*s+k+p); fys=q(2*s+k-p)
      else
        fx0=work((a-1)*s+k); fxe=work((a-1)*s+k+1); fxw=work((a-1)*s+k-1)
        fy0=work(a*s+k); fyn=work(a*s+k+p); fys=work(a*s+k-p)
      end if
      east=face(q(b),q(b+1),fx0,fxe,ae)
      west=face(q(b-1),q(b),fxw,fx0,aw)
      north=face(q(b),q(b+p),fy0,fyn,an)
      south=face(q(b-p),q(b),fys,fy0,ast)
      dx=(east-west)/par(1); dy=(north-south)/par(2)
      ell=-(dx+dy); e=q(b)+par(3)*ell
      if(final==0) then
        out(b)=e
      else
        out(b)=base(b)*0.5_8+e*0.5_8
      end if
      e=out(b)
      do yj=1,yc
        do xi=1,xc
          if(xi==1.and.yj==1) cycle
          out(a*s+yrep(yj)*p+xrep(xi))=e
        end do
      end do
    end do
  end subroutine
end module
