{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accepted poster performance integration input",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "presentation",
    "selected_cpu_cores",
    "cpu_resource_interpretation",
    "accepted_campaign_ids",
    "figures",
    "render_metadata",
    "poster_text",
    "cpu_worker_disclosure",
    "measurement_sources"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "accepted"
    },
    "selected_cpu_cores": {
      "const": 248,
      "description": "Configured CPU core ceiling for the main comparison. Actual teams and nonempty owners are recorded separately for each route and grid."
    },
    "accepted_campaign_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cpu_worker_disclosure": {
      "type": "string",
      "minLength": 1,
      "description": "Explain the configured ceiling and common actual paired team. Actual teams appear inside the CPU bars, while separate nonempty spatial-owner counts remain in the source data."
    },
    "figures": {
      "type": "object",
      "required": [
        "sw",
        "ebm"
      ],
      "properties": {
        "sw": {
          "type": "object",
          "required": [
            "svg",
            "png"
          ],
          "properties": {
            "svg": {
              "type": "string",
              "minLength": 1
            },
            "png": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ebm": {
          "type": "object",
          "required": [
            "svg",
            "png"
          ],
          "properties": {
            "svg": {
              "type": "string",
              "minLength": 1
            },
            "png": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "render_metadata": {
      "type": "object",
      "required": [
        "sw",
        "ebm"
      ],
      "properties": {
        "sw": {
          "type": "object",
          "required": [
            "comparison_coverage",
            "paired_summaries",
            "metadata_by_platform",
            "paired_input",
            "outputs",
            "presentation",
            "profile",
            "model",
            "mode",
            "point_definition",
            "observed_range_definition",
            "status"
          ],
          "properties": {
            "paired_summaries": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6
            },
            "paired_input": {
              "allOf": [
                {
                  "$ref": "accepted-input.schema.json"
                }
              ],
              "properties": {
                "paired_records": {
                  "items": {
                    "if": {
                      "properties": {
                        "platform": {
                          "const": "cpu"
                        }
                      },
                      "required": [
                        "platform"
                      ]
                    },
                    "then": {
                      "required": [
                        "series_kind",
                        "run_id",
                        "active_workers",
                        "nonempty_spatial_owners_by_route"
                      ],
                      "properties": {
                        "cpu_cores": {
                          "const": 248
                        },
                        "series_kind": {
                          "const": "primary"
                        },
                        "run_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "active_workers": {
                          "type": "object",
                          "required": [
                            "baseline",
                            "esm_md"
                          ],
                          "properties": {
                            "baseline": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 248
                            },
                            "esm_md": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 248
                            }
                          }
                        },
                        "nonempty_spatial_owners_by_route": {
                          "type": "object",
                          "required": [
                            "baseline",
                            "esm_md"
                          ],
                          "properties": {
                            "baseline": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 248
                            },
                            "esm_md": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 248
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "comparison_coverage": {
              "type": "object",
              "required": [
                "selected_cpu_core_counts",
                "matched_conditions",
                "historical_language_conditions"
              ],
              "properties": {
                "selected_cpu_core_counts": {
                  "const": [
                    248
                  ]
                },
                "matched_conditions": {
                  "const": 6
                },
                "historical_language_conditions": {
                  "const": 0
                }
              }
            },
            "presentation": {
              "const": "matched_absolute_rates"
            },
            "profile": {
              "const": "poster"
            },
            "model": {
              "const": "sw"
            },
            "mode": {
              "const": "matched_rates"
            },
            "point_definition": {
              "const": "useful_updates / median_seconds"
            },
            "observed_range_definition": {
              "const": "minimum and maximum of twelve individual useful-update rates"
            },
            "status": {
              "const": "accepted"
            }
          }
        },
        "ebm": {
          "type": "object",
          "required": [
            "comparison_coverage",
            "paired_summaries",
            "metadata_by_platform",
            "paired_input",
            "outputs",
            "presentation",
            "profile",
            "model",
            "mode",
            "point_definition",
            "observed_range_definition",
            "status"
          ],
          "properties": {
            "paired_summaries": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6
            },
            "paired_input": {
              "allOf": [
                {
                  "$ref": "accepted-input.schema.json"
                }
              ],
              "properties": {
                "paired_records": {
                  "items": {
                    "if": {
                      "properties": {
                        "platform": {
                          "const": "cpu"
                        }
                      },
                      "required": [
                        "platform"
                      ]
                    },
                    "then": {
                      "required": [
                        "series_kind",
                        "run_id",
                        "active_workers",
                        "nonempty_spatial_owners_by_route"
                      ],
                      "properties": {
                        "cpu_cores": {
                          "const": 248
                        },
                        "series_kind": {
                          "const": "primary"
                        },
                        "run_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "active_workers": {
                          "type": "object",
                          "required": [
                            "baseline",
                            "esm_md"
                          ],
                          "properties": {
                            "baseline": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 248
                            },
                            "esm_md": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 248
                            }
                          }
                        },
                        "nonempty_spatial_owners_by_route": {
                          "type": "object",
                          "required": [
                            "baseline",
                            "esm_md"
                          ],
                          "properties": {
                            "baseline": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 248
                            },
                            "esm_md": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 248
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "comparison_coverage": {
              "type": "object",
              "required": [
                "selected_cpu_core_counts",
                "matched_conditions",
                "historical_language_conditions"
              ],
              "properties": {
                "selected_cpu_core_counts": {
                  "const": [
                    248
                  ]
                },
                "matched_conditions": {
                  "const": 6
                },
                "historical_language_conditions": {
                  "const": 0
                }
              }
            },
            "presentation": {
              "const": "matched_absolute_rates"
            },
            "profile": {
              "const": "poster"
            },
            "model": {
              "const": "ebm"
            },
            "mode": {
              "const": "matched_rates"
            },
            "point_definition": {
              "const": "useful_updates / median_seconds"
            },
            "observed_range_definition": {
              "const": "minimum and maximum of twelve individual useful-update rates"
            },
            "status": {
              "const": "accepted"
            }
          }
        }
      }
    },
    "poster_text": {
      "type": "object",
      "required": [
        "sw_intro",
        "ebm_intro",
        "caption",
        "takeaways"
      ],
      "properties": {
        "sw_intro": {
          "type": "string",
          "minLength": 1
        },
        "ebm_intro": {
          "type": "string",
          "minLength": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "takeaways": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "presentation": {
      "const": "matched_absolute_rates"
    },
    "cpu_resource_interpretation": {
      "const": "configured_ceiling"
    },
    "measurement_sources": {
      "type": "object",
      "required": [
        "cpu",
        "gpu"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "gpu": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
