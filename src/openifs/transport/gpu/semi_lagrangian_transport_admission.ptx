st.param.u64 [a],%args;st.param.u64 [c],%ctx;st.param.u32 [stage],2;st.param.u32 [source_block],%block;call.uni openifs_call_sl_prepare_child,(a,c,stage,source_block);
mov.u64 %vector,%scratch;add.u64 %childContext,%scratch,512;st.param.u64 [a],%vector;st.param.u64 [c],%childContext;call.uni (admitted),openifs_call_sl_lapineb_structural_admit,(a,c);ld.param.u32 %error,[admitted];setp.ne.u32 %p,%error,0;@%p bra REFUSE;
add.u32 %block,%block,1;setp.lt.u32 %p,%block,86;@%p bra ADMIT_FIELD_BLOCK;mov.u32 %error,0;
REFUSE:st.param.u32 [result],%error;ret;
}
