// GPU contract: skills/md2fort-gpu/references/openifs/setup/spline_lu_factorization_complete_contract.md.
.version 8.5
.target sm_90
.address_size 64
.extern .func (.param .align 8 .b8 out[16]) md2asm_gpu_mul_status(.param .b64 a,.param .b64 b);
.extern .func (.param .align 8 .b8 out[16]) md2asm_gpu_div_status(.param .b64 a,.param .b64 b);
.extern .func (.param .align 8 .b8 out[24]) md2asm_gpu_exact_product_sum(.param .b64 a,.param .b64 b,.param .b64 c);
.visible .func (.param .align 8 .b8 out[32]) md2asm_gpu_spline_lu_factor_values(.param .u32 dimension,.param .u64 matrix,.param .u64 pivots,.param .u64 info)
{
.reg .u64 %mat,%piv,%infoptr,%n64,%j,%i,%k,%pivot,%col,%othercol,%ptr,%ptr2,%off,%word,%nf,%nw;
.reg .u32 %n,%sourceinfo,%flags,%raised,%class,%small;
.reg .b64 %best,%bestabs,%value,%magnitude,%swap,%reciprocal,%factor,%left,%old,%result,%one,%negativeone,%minimum,%zero;
.reg .pred %p;
.param .b64 ma,mb,mc;.param .align 8 .b8 arithmetic[16],exact[24];
ld.param.u32 %n,[dimension];cvt.u64.u32 %n64,%n;
ld.param.u64 %mat,[matrix];ld.param.u64 %piv,[pivots];ld.param.u64 %infoptr,[info];
mov.u32 %sourceinfo,0;st.global.u32 [%infoptr],%sourceinfo;
mov.u32 %flags,0;mov.u64 %nf,0;mov.u64 %nw,0;
mov.b64 %one,0x3ff0000000000000;mov.b64 %negativeone,0xbff0000000000000;
mov.b64 %minimum,0x0010000000000000;mov.b64 %zero,0;mov.u64 %j,0;
COLUMN:
mul.lo.u64 %off,%j,%n64;shl.b64 %off,%off,3;add.u64 %col,%mat,%off;
shl.b64 %off,%j,3;add.u64 %ptr,%col,%off;ld.global.b64 %best,[%ptr];
and.b64 %bestabs,%best,0x7fffffffffffffff;mov.u64 %pivot,%j;add.u64 %i,%j,1;
setp.ge.u64 %p,%i,%n64;@%p bra PIVOT_READY;
PIVOT_SCAN:
shl.b64 %off,%i,3;add.u64 %ptr,%col,%off;ld.global.b64 %value,[%ptr];
and.b64 %magnitude,%value,0x7fffffffffffffff;
setp.gt.f64 %p,%magnitude,%bestabs;@!%p bra PIVOT_NEXT;
mov.u64 %pivot,%i;mov.b64 %best,%value;mov.b64 %bestabs,%magnitude;
PIVOT_NEXT:add.u64 %i,%i,1;setp.lt.u64 %p,%i,%n64;@%p bra PIVOT_SCAN;
PIVOT_READY:
add.u64 %word,%pivot,1;cvt.u32.u64 %small,%word;shl.b64 %off,%j,2;add.u64 %ptr,%piv,%off;st.global.u32 [%ptr],%small;
setp.eq.f64 %p,%best,%zero;@%p bra ZERO_PIVOT;
setp.eq.u64 %p,%pivot,%j;@%p bra SCALE;mov.u64 %k,0;
SWAP:
mul.lo.u64 %off,%k,%n64;shl.b64 %off,%off,3;add.u64 %othercol,%mat,%off;
shl.b64 %off,%j,3;add.u64 %ptr,%othercol,%off;
shl.b64 %off,%pivot,3;add.u64 %ptr2,%othercol,%off;
ld.global.b64 %value,[%ptr];ld.global.b64 %swap,[%ptr2];
st.global.b64 [%ptr],%swap;st.global.b64 [%ptr2],%value;
add.u64 %k,%k,1;setp.lt.u64 %p,%k,%n64;@%p bra SWAP;
SCALE:
add.u64 %i,%j,1;setp.ge.u64 %p,%i,%n64;@%p bra UPDATE;
setp.lt.f64 %p,%bestabs,%minimum;@%p bra DIVIDE_LOWER;
st.param.b64 [ma],%one;st.param.b64 [mb],%best;
call.uni (arithmetic),md2asm_gpu_div_status,(ma,mb);
ld.param.b64 %reciprocal,[arithmetic];ld.param.u32 %raised,[arithmetic+8];or.b32 %flags,%flags,%raised;
MULTIPLY_LOWER:
shl.b64 %off,%i,3;add.u64 %ptr,%col,%off;ld.global.b64 %value,[%ptr];
st.param.b64 [ma],%reciprocal;st.param.b64 [mb],%value;
call.uni (arithmetic),md2asm_gpu_mul_status,(ma,mb);
ld.param.b64 %result,[arithmetic];ld.param.u32 %raised,[arithmetic+8];or.b32 %flags,%flags,%raised;
st.global.b64 [%ptr],%result;add.u64 %i,%i,1;setp.lt.u64 %p,%i,%n64;@%p bra MULTIPLY_LOWER;bra UPDATE;
DIVIDE_LOWER:
shl.b64 %off,%i,3;add.u64 %ptr,%col,%off;ld.global.b64 %value,[%ptr];
st.param.b64 [ma],%value;st.param.b64 [mb],%best;
call.uni (arithmetic),md2asm_gpu_div_status,(ma,mb);
ld.param.b64 %result,[arithmetic];ld.param.u32 %raised,[arithmetic+8];or.b32 %flags,%flags,%raised;
st.global.b64 [%ptr],%result;add.u64 %i,%i,1;setp.lt.u64 %p,%i,%n64;@%p bra DIVIDE_LOWER;bra UPDATE;
ZERO_PIVOT:
setp.ne.u32 %p,%sourceinfo,0;@%p bra UPDATE;
add.u64 %word,%j,1;cvt.u32.u64 %sourceinfo,%word;st.global.u32 [%infoptr],%sourceinfo;
UPDATE:
add.u64 %k,%j,1;setp.ge.u64 %p,%k,%n64;@%p bra NEXT_COLUMN;
UPDATE_COLUMN:
mul.lo.u64 %off,%k,%n64;shl.b64 %off,%off,3;add.u64 %othercol,%mat,%off;
shl.b64 %off,%j,3;add.u64 %ptr,%othercol,%off;ld.global.b64 %value,[%ptr];
setp.eq.f64 %p,%value,%zero;@%p bra NEXT_UPDATE_COLUMN;
st.param.b64 [ma],%negativeone;st.param.b64 [mb],%value;
call.uni (arithmetic),md2asm_gpu_mul_status,(ma,mb);
ld.param.b64 %factor,[arithmetic];ld.param.u32 %raised,[arithmetic+8];or.b32 %flags,%flags,%raised;
add.u64 %i,%j,1;
UPDATE_ROW:
shl.b64 %off,%i,3;add.u64 %ptr,%col,%off;add.u64 %ptr2,%othercol,%off;
ld.global.b64 %left,[%ptr];ld.global.b64 %old,[%ptr2];
st.param.b64 [ma],%left;st.param.b64 [mb],%factor;st.param.b64 [mc],%old;
call.uni (exact),md2asm_gpu_exact_product_sum,(ma,mb,mc);
ld.param.b64 %result,[exact];ld.param.u32 %raised,[exact+8];ld.param.u32 %class,[exact+16];
or.b32 %flags,%flags,%raised;
setp.eq.u32 %p,%class,0;@%p add.u64 %nf,%nf,1;@!%p add.u64 %nw,%nw,1;
st.global.b64 [%ptr2],%result;add.u64 %i,%i,1;setp.lt.u64 %p,%i,%n64;@%p bra UPDATE_ROW;
NEXT_UPDATE_COLUMN:add.u64 %k,%k,1;setp.lt.u64 %p,%k,%n64;@%p bra UPDATE_COLUMN;
NEXT_COLUMN:add.u64 %j,%j,1;setp.lt.u64 %p,%j,%n64;@%p bra COLUMN;
st.param.u32 [out],0;st.param.u32 [out+4],%sourceinfo;st.param.u32 [out+8],%flags;st.param.u32 [out+12],0;
st.param.u64 [out+16],%nf;st.param.u64 [out+24],%nw;ret;
}
