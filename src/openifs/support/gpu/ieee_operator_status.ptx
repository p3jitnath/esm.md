 mov.u32 %flags,2;
BINARY_SIGNED_INFINITY:
 or.b64 %r,%sign,0x7ff0000000000000;
 bra BINARY_DONE;
BINARY_SIGNED_ZERO:
 mov.b64 %r,%sign;
 bra BINARY_DONE;
BINARY_RETURN_A:
 mov.b64 %r,%a;
 bra BINARY_DONE;
BINARY_RETURN_B:
 mov.b64 %r,%b;
 bra BINARY_DONE;
BINARY_NAN_A_INVALID:
 mov.u32 %flags,1;
BINARY_NAN_A:
 or.b64 %r,%a,0x0008000000000000;
 bra BINARY_DONE;
BINARY_NAN_B_INVALID:
 mov.u32 %flags,1;
BINARY_NAN_B:
 or.b64 %r,%b,0x0008000000000000;
 bra BINARY_DONE;
BINARY_INVALID:
 mov.b64 %r,0x7ff8000000000000;
 mov.u32 %flags,1;
BINARY_DONE:
 st.param.b64 [result_flags_event],%r;
 st.param.b32 [result_flags_event+8],%flags;
 st.param.b32 [result_flags_event+12],0;
