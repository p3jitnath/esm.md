 and.b64 %qb,%b,0x0008000000000000;
 setp.eq.u64 %asn,%qa,0;
 setp.eq.u64 %bsn,%qb,0;
 and.pred %asn,%asn,%an;
 and.pred %bsn,%bsn,%bn;
