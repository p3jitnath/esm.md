 @%asn bra BINARY_NAN_A_INVALID;
 @%bsn bra BINARY_NAN_B_INVALID;
 @%an bra BINARY_NAN_A;
 @%bn bra BINARY_NAN_B;
 setp.eq.u64 %ai,%ax,0x7ff0000000000000;
 setp.eq.u64 %bi,%bx,0x7ff0000000000000;
 setp.eq.u64 %az,%ax,0;
 setp.eq.u64 %bz,%bx,0;
 xor.b64 %sign,%a,%b;
 and.b64 %sign,%sign,0x8000000000000000;
 setp.le.u32 %p,%op,1;
 @%p bra BINARY_ADD_SUB;
 setp.eq.u32 %p,%op,2;
 @%p bra BINARY_MUL;
 bra BINARY_DIV;
BINARY_ADD_SUB:
 setp.eq.u32 %p,%op,1;
 @%p xor.b64 %b,%b,0x8000000000000000;
 and.pred %p,%ai,%bi;
 @!%p bra BINARY_ADD_ONE_INF;
 xor.b64 %tmp,%a,%b;
 shr.u64 %tmp,%tmp,63;
 setp.ne.u64 %p,%tmp,0;
 @%p bra BINARY_INVALID;
BINARY_ADD_ONE_INF:
 @%ai bra BINARY_RETURN_A;
 @%bi bra BINARY_RETURN_B;
 {
 .param .b64 a,b;
 .param .align 8 .b8 ret[16];
 st.param.b64 [a],%a;
 st.param.b64 [b],%b;
 call.uni (ret),md2asm_gpu_add_rn,(a,b);
 ld.param.b64 %r,[ret];
 ld.param.b32 %flags,[ret+8];
 }
 bra BINARY_DONE;
BINARY_MUL:
 and.pred %p,%ai,%bz;
 and.pred %q,%bi,%az;
 or.pred %p,%p,%q;
 @%p bra BINARY_INVALID;
 or.pred %p,%ai,%bi;
 @%p bra BINARY_SIGNED_INFINITY;
 {
 .param .b64 a,b;
 .param .align 8 .b8 ret[16];
 st.param.b64 [a],%a;
 st.param.b64 [b],%b;
 call.uni (ret),md2asm_gpu_mul_rn,(a,b);
 ld.param.b64 %r,[ret];
 ld.param.b32 %flags,[ret+8];
 }
 bra BINARY_DONE;
BINARY_DIV:
 and.pred %p,%ai,%bi;
 and.pred %q,%az,%bz;
 or.pred %p,%p,%q;
 @%p bra BINARY_INVALID;
 @%ai bra BINARY_SIGNED_INFINITY;
 @%bi bra BINARY_SIGNED_ZERO;
 @%bz bra BINARY_DIV_ZERO;
 @%az bra BINARY_SIGNED_ZERO;
 {
 .param .b64 a,b;
 .param .align 8 .b8 ret[16];
 st.param.b64 [a],%a;
 st.param.b64 [b],%b;
 call.uni (ret),md2asm_gpu_finite_div_status,(a,b);
 ld.param.b64 %r,[ret];
 ld.param.b32 %flags,[ret+8];
 }
 bra BINARY_DONE;
