// Interface and lifetime: skills/md2asm-gpu/references/openifs/cuda_runtime.md revision 7.
.version 8.5
.target sm_90
.address_size 64
.extern .func md2asm_gpu_mailbox_soil_water_body(.param .u64 a,.param .u64 c);
.extern .func md2asm_gpu_mailbox_lake_controller_body(.param .u64 a,.param .u64 c);
.extern .func md2asm_gpu_mailbox_startup_integer_body(.param .u64 a,.param .u64 c);
.extern .func md2asm_gpu_mailbox_canopy_light_body(.param .u64 a,.param .u64 c);
.extern .func md2asm_gpu_mailbox_lake_energy_body(.param .u64 a,.param .u64 c);
.extern .func md2asm_gpu_mailbox_output_numeric_body(.param .u64 a,.param .u64 c);
.extern .func md2asm_gpu_mailbox_physical_setup_numeric_body(.param .u64 a,.param .u64 c);
.extern .func md2asm_gpu_mailbox_setup_span_body(.param .u64 a,.param .u64 c);
// One serial client; mailbox lives until the stop acknowledgement and stream join.
.visible .entry md2asm_gpu_soil_water_mailbox_worker(.param .u64 mailbox)
{
 .reg .u64 %m,%seq,%previous,%argv,%ctx,%done;
 .reg .u32 %op;
 .reg .pred %p;
 .param .u64 a,c,lake_a,lake_c,startup_a,startup_c,canopy_a,canopy_c,lake_energy_a,lake_energy_c,output_numeric_a,output_numeric_c,physical_setup_numeric_a,physical_setup_numeric_c,setup_span_a,setup_span_c;
 ld.param.u64 %m,[mailbox];
 add.u64 %done,%m,8;
 ld.acquire.sys.global.u64 %previous,[%done];
WAIT:
 ld.acquire.sys.global.u64 %seq,[%m];
 setp.eq.u64 %p,%seq,%previous;
 @%p bra WAIT;
 ld.global.u32 %op,[%m+16];
 st.global.u32 [%m+20],0;
 setp.eq.u32 %p,%op,0;
 @%p bra STOP;
 setp.ne.u32 %p,%op,1;
 @%p bra CHECK_LAKE;
 ld.global.u64 %argv,[%m+24];
 ld.global.u64 %ctx,[%m+32];
 st.param.u64 [a],%argv;
 st.param.u64 [c],%ctx;
 call.uni md2asm_gpu_mailbox_soil_water_body,(a,c);
 bra COMPLETE;
CHECK_LAKE:
 setp.ne.u32 %p,%op,2;
 @%p bra CHECK_STARTUP;
 ld.global.u64 %argv,[%m+24];
 ld.global.u64 %ctx,[%m+32];
 st.param.u64 [lake_a],%argv;
 st.param.u64 [lake_c],%ctx;
 call.uni md2asm_gpu_mailbox_lake_controller_body,(lake_a,lake_c);
 bra COMPLETE;
CHECK_STARTUP:
 setp.ne.u32 %p,%op,3;
 @%p bra CHECK_CANOPY;
 ld.global.u64 %argv,[%m+24];
 ld.global.u64 %ctx,[%m+32];
 st.param.u64 [startup_a],%argv;
 st.param.u64 [startup_c],%ctx;
 call.uni md2asm_gpu_mailbox_startup_integer_body,(startup_a,startup_c);
 bra COMPLETE;
CHECK_CANOPY:
 setp.ne.u32 %p,%op,4;
 @%p bra CHECK_LAKE_ENERGY;
 ld.global.u64 %argv,[%m+24];
 ld.global.u64 %ctx,[%m+32];
 st.param.u64 [canopy_a],%argv;
 st.param.u64 [canopy_c],%ctx;
 call.uni md2asm_gpu_mailbox_canopy_light_body,(canopy_a,canopy_c);
 bra COMPLETE;
CHECK_LAKE_ENERGY:
 setp.ne.u32 %p,%op,5;
 @%p bra CHECK_OUTPUT_NUMERIC;
 ld.global.u64 %argv,[%m+24];
 ld.global.u64 %ctx,[%m+32];
 st.param.u64 [lake_energy_a],%argv;
 st.param.u64 [lake_energy_c],%ctx;
 call.uni md2asm_gpu_mailbox_lake_energy_body,(lake_energy_a,lake_energy_c);
 bra COMPLETE;
CHECK_OUTPUT_NUMERIC:
 setp.ne.u32 %p,%op,6;
 @%p bra CHECK_PHYSICAL_SETUP_NUMERIC;
 ld.global.u64 %argv,[%m+24];
 ld.global.u64 %ctx,[%m+32];
 st.param.u64 [output_numeric_a],%argv;
 st.param.u64 [output_numeric_c],%ctx;
 call.uni md2asm_gpu_mailbox_output_numeric_body,(output_numeric_a,output_numeric_c);
 bra COMPLETE;
CHECK_PHYSICAL_SETUP_NUMERIC:
 setp.ne.u32 %p,%op,7;
 @%p bra CHECK_SETUP_SPAN;
 ld.global.u64 %argv,[%m+24];
 ld.global.u64 %ctx,[%m+32];
 st.param.u64 [physical_setup_numeric_a],%argv;
 st.param.u64 [physical_setup_numeric_c],%ctx;
 call.uni md2asm_gpu_mailbox_physical_setup_numeric_body,(physical_setup_numeric_a,physical_setup_numeric_c);
 bra COMPLETE;
CHECK_SETUP_SPAN:
 setp.ne.u32 %p,%op,8;
 @%p bra INVALID;
 ld.global.u64 %argv,[%m+24];
 ld.global.u64 %ctx,[%m+32];
 st.param.u64 [setup_span_a],%argv;
 st.param.u64 [setup_span_c],%ctx;
 call.uni md2asm_gpu_mailbox_setup_span_body,(setup_span_a,setup_span_c);
 bra COMPLETE;
INVALID:
 st.global.u32 [%m+20],1;
COMPLETE:
 st.release.sys.global.u64 [%done],%seq;
 mov.u64 %previous,%seq;
 bra WAIT;
STOP:
 st.release.sys.global.u64 [%done],%seq;
 ret;
}
