.version 8.5
.target sm_90
.address_size 64
.extern .func (.param .align 8 .b8 result[16]) md2asm_gpu_add_status(.param .b64 left,.param .b64 right);
.extern .func (.param .align 8 .b8 result[16]) md2asm_gpu_sub_status(.param .b64 left,.param .b64 right);
