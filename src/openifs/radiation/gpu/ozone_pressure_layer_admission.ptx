FIRST_PRESSURE:mov.u64 %climfirst,%word;
PRESSURE_OK:mov.u64 %prev,%word;add.u64 %k,%k,1;setp.le.u64 %p,%k,%maxp;@%p bra PRESSURE_COORDINATES;sub.u64 %sourcecol,%first,1;
MODEL_COLUMN:setp.ge.u64 %p,%sourcecol,%last;@%p bra SUCCESS;mov.u64 %level,0;
MODEL_PRESSURE:mad.lo.u64 %index,%level,%P,%sourcecol;shl.b64 %offset,%index,3;add.u64 %ptr,%v8,%offset;ld.u64 %word,[%ptr];and.b64 %absolute,%word,0x7fffffffffffffff;
mov.u32 %error,7774;setp.gt.u64 %p,%absolute,0x7fefffffffffffff;@%p bra RETURN;
setp.eq.u64 %p,%absolute,0;@%p mov.u64 %word,0;
mov.u32 %error,7774;setp.gt.u64 %p,%word,0x7fffffffffffffff;@%p bra RETURN;
mov.u32 %error,7774;setp.lt.u64 %p,%word,%climfirst;@%p bra RETURN;
setp.eq.u64 %p,%level,0;@%p bra MODEL_PRESSURE_OK;
mov.u32 %error,7774;setp.le.u64 %p,%word,%prev;@%p bra RETURN;
MODEL_PRESSURE_OK:mov.u64 %prev,%word;add.u64 %level,%level,1;setp.le.u64 %p,%level,%N;@%p bra MODEL_PRESSURE;add.u64 %sourcecol,%sourcecol,%step;bra MODEL_COLUMN;
SUCCESS:mov.u32 %error,0;
RETURN:st.param.u32 [error],%error;ret;
}
