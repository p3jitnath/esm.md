 {
 .param .b64 a,b,c; .param .align 8 .b8 result[32];
 st.param.b64 [a],%x; st.param.b64 [b],%y; st.param.b64 [c],%z;
 call.uni (result),md2asm_gpu_clear_longwave_layer_values,(a,b,c);
 ld.param.b64 %x,[result]; ld.param.b64 %y,[result+8]; ld.param.b64 %z,[result+16];
 ld.param.u32 %raised,[result+24]; ld.param.u32 %event,[result+28]; or.b32 %flags,%flags,%raised;
 }
 add.u64 %a,%tr,%offset; add.u64 %b,%up,%offset; add.u64 %c,%dn,%offset;
 st.global.b64 [%a],%x; st.global.b64 [%b],%y; st.global.b64 [%c],%z;
 setp.eq.u32 %p0,%event,0; @%p0 bra NEXT;
 add.u64 %ordinal,%cell,1; shl.b64 %ordinal,%ordinal,8; cvt.u64.u32 %tmp,%event; or.b64 %ordinal,%ordinal,%tmp;
 add.u64 %tmp,%ctx,16; atom.global.max.u64 %old64,[%tmp],%ordinal;
NEXT:
 add.u64 %cell,%cell,%step; bra CELL;
COMPLETE:
 add.u64 %tmp,%ctx,8; atom.global.or.b32 %old,[%tmp],%flags; ret;
REFUSE:
 setp.ne.u32 %p0,%unique,0; @%p0 ret; atom.global.cas.b32 %old,[%ctx],0,%error; ret;
}
