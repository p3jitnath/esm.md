ld.shared.u64 %ecl_value,[%ecl_scanrow+8];max.u64 %ecl_join_event,%ecl_join_event,%ecl_value;ld.shared.u64 %ecl_value,[%ecl_scanrow+16];add.u64 %ecl_join_fast,%ecl_join_fast,%ecl_value;ld.shared.u64 %ecl_value,[%ecl_scanrow+24];add.u64 %ecl_join_wide,%ecl_join_wide,%ecl_value;
add.u32 %ecl_scan,%ecl_scan,1;setp.lt.u32 %ecl_pred,%ecl_scan,8;@%ecl_pred bra ECL_SCAN;bar.sync 0;
mov.u64 %event,%ecl_join_event;mov.u64 %fast,%ecl_join_fast;mov.u64 %wide,%ecl_join_wide;
st.param.u32 [result],%flags;st.param.u32 [result+4],0;st.param.u64 [result+8],%event;st.param.u64 [result+16],%fast;st.param.u64 [result+24],%wide;ret;
}
