LAYER:
 sub.u32 %layer,%layer,1; mov.b64 %response,0; mov.u32 %i,0;
 setp.le.s32 %p0,%g,0; @%p0 bra STORE_RESPONSE;
 mul.wide.u32 %temp,%layer,8; mul.lo.u64 %temp,%temp,%ng64; add.u64 %taddr,%ptr3,%temp;
SPECTRUM:
 mul.wide.u32 %offset,%i,8; add.u64 %qaddr,%scratch,%offset; ld.global.b64 %q,[%qaddr]; add.u64 %addr,%taddr,%offset; ld.global.b64 %value,[%addr];
 st.param.b64 [ma],%q; st.param.b64 [mb],%value; call.uni (math),md2asm_gpu_mul_status,(ma,mb); ld.param.b64 %q,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 st.global.b64 [%qaddr],%q;
 st.param.b64 [ma],%response; st.param.b64 [mb],%q; call.uni (math),md2asm_gpu_add_status,(ma,mb); ld.param.b64 %response,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 add.u32 %i,%i,1; setp.lt.u32 %p0,%i,%g; @%p0 bra SPECTRUM;
STORE_RESPONSE:
 sub.u64 %current,%current,%levelstep; setp.eq.u32 %p0,%mode,0; @%p0 bra STORE;
 ld.global.b64 %oldvalue,[%current];
 st.param.b64 [ma],%factor; st.param.b64 [mb],%oldvalue; call.uni (math),md2asm_gpu_mul_status,(ma,mb); ld.param.b64 %leftvalue,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 st.param.b64 [ma],%weight; st.param.b64 [mb],%response; call.uni (math),md2asm_gpu_mul_status,(ma,mb); ld.param.b64 %rightvalue,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 st.param.b64 [ma],%leftvalue; st.param.b64 [mb],%rightvalue; call.uni (math),md2asm_gpu_add_status,(ma,mb); ld.param.b64 %response,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
STORE:
