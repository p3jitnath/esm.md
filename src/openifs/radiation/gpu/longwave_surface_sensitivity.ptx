 st.param.b64 [wa],%value; st.param.u64 [wm],0x7fefffffffffffff; call.uni (rr),sensitivity_word,(wa,wm); ld.param.u32 %error,[rr]; setp.ne.u32 %p0,%error,0; @%p0 bra REFUSE_INPUT;
 st.param.b64 [ma],%total; st.param.b64 [mb],%value; call.uni (math),md2asm_gpu_add_status,(ma,mb); ld.param.b64 %total,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 add.u32 %i,%i,1; setp.lt.u32 %p0,%i,%g; @%p0 bra FLUX_ADMISSION;
 setp.eq.u64 %p0,%total,0; @%p0 bra REFUSE_INPUT; setp.ge.u64 %p0,%total,0x7ff0000000000000; @%p0 bra REFUSE_INPUT;
 mov.u64 %offset,0;
TRANS_ADMISSION:
 setp.ge.u64 %p0,%offset,%transbytes; @%p0 bra NORMALIZE_START; add.u64 %addr,%ptr3,%offset; ld.global.b64 %value,[%addr];
 st.param.b64 [wa],%value; st.param.u64 [wm],0x3ff0000000000000; call.uni (rr),sensitivity_word,(wa,wm); ld.param.u32 %error,[rr]; setp.ne.u32 %p0,%error,0; @%p0 bra REFUSE_INPUT;
 add.u64 %offset,%offset,8; bra TRANS_ADMISSION;
NORMALIZE_START:
 mov.u32 %i,0;
NORMALIZE:
 mul.wide.u32 %offset,%i,8; add.u64 %addr,%ptr4,%offset; ld.global.b64 %value,[%addr];
 st.param.b64 [ma],%value; st.param.b64 [mb],%total; call.uni (math),md2asm_gpu_div_status,(ma,mb); ld.param.b64 %q,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 add.u64 %qaddr,%scratch,%offset; st.global.b64 [%qaddr],%q; add.u32 %i,%i,1; setp.lt.u32 %p0,%i,%g; @%p0 bra NORMALIZE;
SURFACE:
 mul.lo.u64 %temp,%n64,%levelstep; add.u64 %current,%output,%temp; mov.b64 %value,0x3ff0000000000000; st.global.b64 [%current],%value;
 setp.eq.u32 %p0,%n,0; @%p0 bra COMPLETE; setp.eq.u32 %p0,%mode,0; @%p0 bra LAYERS_READY;
 st.param.b64 [ma],0x3ff0000000000000; st.param.b64 [mb],%weight; call.uni (math),md2asm_gpu_sub_status,(ma,mb); ld.param.b64 %factor,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
LAYERS_READY:
