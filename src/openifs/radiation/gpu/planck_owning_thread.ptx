CALCULATE_SPECTRAL:
 mul.wide.u32 %tmp,%i,4;
 add.u64 %at,%bandmap,%tmp;
 ld.global.u32 %band,[%at];
 sub.u32 %band,%band,1;
 mul.wide.u32 %tmp2,%band,8;
 add.u64 %bandaddr,%bands,%tmp2;
 ld.local.b64 %bandvalue,[%bandaddr];
 cvt.u64.u32 %sample,%i;
 setp.eq.u64 %p,%samplemap,0;
 @%p bra SAMPLE_READY;
 add.u64 %at,%samplemap,%tmp;
 ld.global.u32 %q,[%at];
 sub.u32 %q,%q,1;
 cvt.u64.u32 %sample,%q;
SAMPLE_READY:
 mov.u64 %layer,0;
 setp.eq.u32 %p,%mode,0;
 @%p bra LAYER_READY;
 cvt.u64.u32 %layer,%h;
 sub.u64 %layer,%layer,%face;
 setp.eq.u64 %p,%face,0;
 @%p sub.u64 %layer,%layer,1;
LAYER_READY:
 mul.lo.u64 %tmp,%layer,140;
 add.u64 %tmp,%tmp,%sample;
 mul.lo.u64 %tmp,%tmp,%n64;
 add.u64 %tmp,%tmp,%column;
 shl.b64 %tmp,%tmp,3;
 add.u64 %at,%pf,%tmp;
 ld.global.b64 %fraction,[%at];
 mov.b64 %op_a,%bandvalue;
 mov.b64 %op_b,%fraction;
 {
 .param .b64 a,b;
 .param .align 8 .b8 ret[16];
 st.param.b64 [a],%op_a;
 st.param.b64 [b],%op_b;
 call.uni (ret),md2asm_gpu_mul_rn,(a,b);
 ld.param.b64 %word,[ret];
 ld.param.b32 %raised,[ret+8];
 or.b32 %flags,%flags,%raised;
 }
 mul.lo.u64 %tmp,%index,%g64;
 cvt.u64.u32 %tmp2,%i;
 add.u64 %tmp,%tmp,%tmp2;
 shl.b64 %tmp,%tmp,3;
 add.u64 %at,%out,%tmp;
 st.global.b64 [%at],%word;
 add.u32 %i,%i,1;
 setp.lt.u32 %p,%i,%g;
 @%p bra CALCULATE_SPECTRAL;
 add.u64 %index,%index,%thread_step;
 bra CALCULATE_PAIR;
COMPLETE:
 add.u64 %at,%ctx,8;
 atom.global.or.b32 %old,[%at],%flags;
 ret;
EMPTY_WORK:
 mov.u32 %flags,0;
 mov.b64 %lo,0x3ff921fb54442d18;
 mov.b64 %hi,0x4000000000000000;
 mov.b64 %op_a,%lo;
 mov.b64 %op_b,%hi;
 {
 .param .b64 a,b;
 .param .align 8 .b8 ret[16];
 st.param.b64 [a],%op_a;
 st.param.b64 [b],%op_b;
 call.uni (ret),md2asm_gpu_mul_rn,(a,b);
 ld.param.b64 %zflux,[ret];
 ld.param.b32 %raised,[ret+8];
 or.b32 %flags,%flags,%raised;
 }
 mov.b64 %hi,0x40c3880000000000;
 mov.b64 %op_a,%zflux;
 mov.b64 %op_b,%hi;
 {
 .param .b64 a,b;
 .param .align 8 .b8 ret[16];
 st.param.b64 [a],%op_a;
 st.param.b64 [b],%op_b;
 call.uni (ret),md2asm_gpu_mul_rn,(a,b);
 ld.param.b64 %zflux,[ret];
 ld.param.b32 %raised,[ret+8];
 or.b32 %flags,%flags,%raised;
 }
 bra COMPLETE;
BAD_LAUNCH:
 mov.u32 %failure,301;
 bra REFUSE;
BAD_METADATA:
 mov.u32 %failure,302;
 bra REFUSE;
BAD_VALUES:
 mov.u32 %failure,303;
REFUSE:
 mov.u32 %q,0;
 mov.u32 %r,0;
 or.b32 %q,%q,%r;
 or.b32 %q,%q,%lane;
 setp.eq.u32 %p,%q,0;
 @%p atom.global.cas.b32 %old,[%ctx],0,%failure;
 ret;
}
