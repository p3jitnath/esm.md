 mov.u32 %error,362; add.u64 %end1,%low,%span; add.u64 %end2,%countptr,4;
 setp.lt.u64 %p0,%low,%end2; setp.lt.u64 %p1,%countptr,%end1; and.pred %p2,%p0,%p1; @%p2 bra REFUSE;
