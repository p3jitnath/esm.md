// Return first cell, element stride, reached owner low/span and integer error.
.func (.param .align 8 .b8 result[40]) two_stream_descriptor_span(.param .u64 descriptor,.param .u32 count)
{
 .reg .u64 %d,%base,%stride,%mag,%n,%high,%gap,%low,%span,%tmp; .reg .u32 %n32,%error; .reg .pred %p;
 ld.param.u64 %d,[descriptor]; ld.param.u32 %n32,[count]; mov.u32 %error,362;
 setp.eq.u64 %p,%d,0; @%p bra SPAN_RETURN;
 and.b64 %tmp,%d,7; setp.ne.u64 %p,%tmp,0; @%p bra SPAN_RETURN;
 setp.gt.u64 %p,%d,0x7fffffffffffffbf; @%p bra SPAN_RETURN;
 ld.global.u64 %base,[%d]; ld.global.s64 %stride,[%d+40];
 setp.eq.u64 %p,%base,0; @%p bra SPAN_RETURN;
 and.b64 %tmp,%base,7; setp.ne.u64 %p,%tmp,0; @%p bra SPAN_RETURN;
 setp.gt.u64 %p,%base,0x7fffffffffffffff; @%p bra SPAN_RETURN;
 setp.eq.u64 %p,%stride,0; @%p mov.u64 %stride,1;
 mov.u64 %mag,%stride; setp.lt.s64 %p,%stride,0; @%p neg.s64 %mag,%stride;
 sub.u32 %n32,%n32,1; cvt.u64.u32 %n,%n32;
 mul.hi.u64 %high,%mag,%n; setp.ne.u64 %p,%high,0; @%p bra SPAN_RETURN;
 mul.lo.u64 %gap,%mag,%n; setp.gt.u64 %p,%gap,0x0ffffffffffffffe; @%p bra SPAN_RETURN;
 shl.b64 %gap,%gap,3; add.u64 %span,%gap,8; mov.u64 %low,%base;
 setp.ge.s64 %p,%stride,0; @%p bra SPAN_END;
 setp.le.u64 %p,%base,%gap; @%p bra SPAN_RETURN;
 sub.u64 %low,%base,%gap;
SPAN_END:
 add.u64 %tmp,%low,%span; setp.gt.u64 %p,%tmp,0x7fffffffffffffff; @%p bra SPAN_RETURN;
 mov.u32 %error,0;
SPAN_RETURN:
 st.param.u64 [result],%base; st.param.u64 [result+8],%stride;
 st.param.u64 [result+16],%low; st.param.u64 [result+24],%span; st.param.u32 [result+32],%error; st.param.u32 [result+36],0; ret;
