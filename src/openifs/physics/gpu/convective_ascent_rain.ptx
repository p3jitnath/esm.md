add.u64 %ptr,%v41,%temporary;st.global.b64 [%ptr],%newwater;
FLUX_NEXT:
add.u32 %column,%column,1;setp.lt.u32 %p,%column,%last;@%p bra FLUX_COLUMN;
bra COMPLETE;

NUMERICAL_ERROR:mov.u32 %error,8504;
COMPLETE:st.param.u32 [returned],%flags;st.param.u32 [returned+4],%error;st.param.u64 [returned+8],%event;st.param.u64 [returned+16],%EXP;st.param.u64 [returned+24],%FAST;st.param.u64 [returned+32],%WIDE;ret;
}
