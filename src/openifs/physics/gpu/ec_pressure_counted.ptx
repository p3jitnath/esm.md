 add.u32 %j,%j,1; setp.le.u32 %p0,%j,%n; @%p0 bra HP_FULL_LOG_LEVEL; bra HP_DONE;
HP_FULL_APPROXIMATE:
 mov.u32 %j,%ifirst;
HP_FULL_APPROXIMATE_LEVEL:
 setp.gt.u32 %p0,%j,%n; @%p0 bra HP_FULL_APPROXIMATE_TOP;
 sub.u32 %i,%first,1;
HP_FULL_APPROXIMATE_CELL:
 mul.wide.u32 %col,%i,8; sub.u32 %rt,%j,1; mul.wide.u32 %cell,%rt,8; mul.lo.u64 %cell,%cell,%np64; add.u64 %cell,%cell,%col;
 sub.u32 %rt,%f3,1; cvt.u64.u32 %address,%rt; mul.lo.u64 %address,%address,%fullbytes; add.u64 %address,%address,%cell; add.u64 %ptr,%scratch,%address;
 ld.global.b64 %A,[%ptr];
 xor.b64 %negative,%A,0x8000000000000000;
 st.param.b64 [ma],0x3ff0000000000000; st.param.b64 [mb],%negative; call.uni (scalar),md2asm_gpu_add_rn,(ma,mb);
 ld.param.b64 %temporary0,[scalar]; ld.param.u32 %raised,[scalar+8]; or.b32 %flags,%flags,%raised;
 add.u64 %ptr,%ph,%cell; add.u64 %ptr,%ptr,%pitch; ld.global.b64 %Plo,[%ptr];
 st.param.b64 [ma],%temporary0; st.param.b64 [mb],%Plo; call.uni (scalar),md2asm_gpu_mul_rn,(ma,mb);
 ld.param.b64 %F,[scalar]; ld.param.u32 %raised,[scalar+8]; or.b32 %flags,%flags,%raised;
 add.u64 %ptr,%pf,%cell; st.global.b64 [%ptr],%F;
 add.u32 %i,%i,1; setp.lt.u32 %p0,%i,%last; @%p0 bra HP_FULL_APPROXIMATE_CELL;
