 add.u64 %r28_table,%r28_table,32; add.u32 %r28_join,%r28_join,1; setp.lt.u32 %r28_skip,%r28_join,32; @%r28_skip bra R28_JOIN;
 mov.u64 %actual_exp,%r28_total;
 setp.eq.u64 %p0,%exp_counter,0; @%p0 bra EC_HP_COUNTER_DONE; ld.global.u64 %address,[%exp_counter]; add.u64 %address,%address,%actual_exp; st.global.u64 [%exp_counter],%address;
EC_HP_COUNTER_DONE:
 atom.global.or.b32 %raised,[%ctx+8],%flags; st.global.u64 [%ctx+16],%lastEvent; ret;
HP_REFUSE: @%r28_leader st.global.u32 [%ctx],%error; ret;
}
