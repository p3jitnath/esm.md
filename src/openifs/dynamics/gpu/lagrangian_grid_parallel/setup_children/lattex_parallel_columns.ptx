 vote.sync.ballot.b32 %parallel_mask,%parallel_bad,0xffffffff;
 setp.eq.u32 %parallel_bad,%parallel_mask,0;
 @%parallel_bad bra PARALLEL_ADMISSION_CLEAN;
 brev.b32 %parallel_reversed,%parallel_mask;
 clz.b32 %parallel_first_bad,%parallel_reversed;
 shfl.sync.idx.b32 %parallel_error,%parallel_error,%parallel_first_bad,0x1f,0xffffffff;
 st.global.u32 [%ctx],%parallel_error;
 ret;
PARALLEL_ADMISSION_CLEAN:
 bar.sync 0;
 mov.u32 %parallel_admitted,1;
 bra PARALLEL_ADMISSION_READY;
REFUSE: st.global.u32 [%ctx],%error; setp.ne.u32 %p0,%parallel_admitted,0; @%p0 ret; bra PARALLEL_ADMISSION_JOIN;
}
