setp.lt.u64 %p,%degree,%offset;
@%p bra PROJECT_DEGREE;
add.u64 %field,%field,1;
setp.lt.u64 %p,%field,%fields;
@%p bra PROJECT_FIELD;
setp.ne.u32 %p,%phase,0;
@%p bra SYMMETRIC_DONE;
ld.global.u64 %counter,[%counts+8];
add.u64 %counter,%counter,1;
st.global.u64 [%counts+8],%counter;
mov.u32 %phase,1;
mov.u64 %basis,%basisS;
mov.u64 %scratch,%scratchS;
mov.u32 %ndegree,%sDegrees;
mov.u32 %start,%sStart;
bra PROJECT_PHASE;
SYMMETRIC_DONE:
ld.global.u64 %counter,[%counts+24];
add.u64 %counter,%counter,1;
st.global.u64 [%counts+24],%counter;
st.param.u32 [returned],%flags;
st.param.u32 [returned+4],0;
