ld.global.u32 %sStart,[%in+116];
mov.u64 %field,0;
WEIGHT_FIELD:
mov.u64 %lat,0;
WEIGHT_LATITUDE:
shl.b64 %offset,%lat,3;
add.u64 %address,%weights,%offset;
ld.global.b64 %w,[%address];
mul.lo.u64 %offset,%lat,%astride;
mad.lo.u64 %offset,%field,%step,%offset;
shl.b64 %offset,%offset,3;
add.u64 %address,%aoa,%offset;
ld.global.b64 %a,[%address];
mul.lo.u64 %offset,%lat,%sstride;
mad.lo.u64 %offset,%field,%step,%offset;
shl.b64 %offset,%offset,3;
add.u64 %address,%soa,%offset;
ld.global.b64 %s,[%address];
{
.param .b64 left,right;
.param .align 8 .b8 result[16];
st.param.b64 [left],%a;
st.param.b64 [right],%w;
call.uni (result),md2asm_gpu_mul_status,(left,right);
ld.param.b64 %a,[result];
ld.param.u32 %raised,[result+8];
or.b32 %flags,%flags,%raised;
}
{
.param .b64 left,right;
.param .align 8 .b8 result[16];
