or.b32 %flags,%flags,%raised;
}
add.u64 %lat,%lat,1;
setp.lt.u64 %p,%lat,16;
@%p bra PROJECT_LATITUDE;
mul.lo.u64 %outindex,%field,%step;
mul.lo.u64 %outindex,%outindex,%pitch;
cvt.u64.u32 %offset,%start;
add.u64 %outindex,%outindex,%offset;
sub.u64 %outindex,%outindex,1;
shl.b64 %offset,%degree,1;
add.u64 %outindex,%outindex,%offset;
shl.b64 %offset,%outindex,3;
add.u64 %address,%out,%offset;
st.global.b64 [%address],%sum;
add.u64 %degree,%degree,1;
