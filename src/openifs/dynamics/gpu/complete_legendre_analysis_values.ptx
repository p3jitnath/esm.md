st.param.b64 [right],%w;
call.uni (result),md2asm_gpu_mul_status,(left,right);
ld.param.b64 %s,[result];
ld.param.u32 %raised,[result+8];
or.b32 %flags,%flags,%raised;
}
shl.b64 %offset,%field,4;
add.u64 %offset,%offset,%lat;
shl.b64 %offset,%offset,3;
add.u64 %address,%scratchA,%offset;
st.global.b64 [%address],%a;
add.u64 %address,%scratchS,%offset;
st.global.b64 [%address],%s;
add.u64 %lat,%lat,1;
setp.lt.u64 %p,%lat,16;
@%p bra WEIGHT_LATITUDE;
add.u64 %field,%field,1;
setp.lt.u64 %p,%field,%fields;
@%p bra WEIGHT_FIELD;
ld.global.u64 %counter,[%counts+0];
add.u64 %counter,%counter,1;
st.global.u64 [%counts+0],%counter;
ld.global.u64 %counter,[%counts+16];
add.u64 %counter,%counter,1;
st.global.u64 [%counts+16],%counter;
mov.u32 %phase,0;
mov.u64 %basis,%basisA;
mov.u64 %scratch,%scratchA;
mov.u32 %ndegree,%aDegrees;
mov.u32 %start,%aStart;
