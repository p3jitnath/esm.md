 st.param.b64 [ma],%a; st.param.b64 [mb],%rd; call.uni (math),md2asm_gpu_sub_status,(ma,mb); ld.param.b64 %a,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 st.param.b64 [ma],%b; st.param.b64 [mb],%cpd; call.uni (math),md2asm_gpu_sub_status,(ma,mb); ld.param.b64 %b,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 st.param.b64 [ma],%a; st.param.b64 [mb],%fraction; call.uni (math),md2asm_gpu_mul_status,(ma,mb); ld.param.b64 %rp,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 st.param.b64 [ma],%b; st.param.b64 [mb],%fraction; call.uni (math),md2asm_gpu_mul_status,(ma,mb); ld.param.b64 %cp,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 setp.ne.u32 %p,%seen,0; @%p bra ADD_COMPONENT; mov.b64 %rsum,%rp; mov.b64 %csum,%cp; mov.u32 %seen,1; bra NEXT_COMPONENT;
ADD_COMPONENT:
 st.param.b64 [ma],%rsum; st.param.b64 [mb],%rp; call.uni (math),md2asm_gpu_add_status,(ma,mb); ld.param.b64 %rsum,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
