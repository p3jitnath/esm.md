}
.visible .func (.param .u32 result) r27_parallel_openifs_gprcp_generic_values(.param .u64 configuration,.param .u64 dry_gas_pointer,.param .u64 dry_heat_pointer,.param .u64 fields,.param .u32 width,.param .u32 levels,.param .u32 first_column,.param .u32 last_column,.param .u32 field_mode,.param .u64 heat_output,.param .u64 gas_output,.param .u64 ratio_output)
{
 .reg .u32 %r27_lane; .reg .pred %r27_leader,%r27_skip;
 mov.u32 %r27_lane,%tid.x; setp.eq.u32 %r27_leader,%r27_lane,0;

