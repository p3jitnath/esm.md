.visible .func (.param .u32 result) r27_parallel_openifs_gprcp_generic_admit(.param .u64 configuration,.param .u64 actual_capacity,.param .u32 field_mode)
{
 .reg .u64 %cfg,%capacity,%ptr,%offset; .reg .u32 %n,%ndim,%mode,%map,%i,%active,%index,%e; .reg .pred %p;
 ld.param.u64 %cfg,[configuration]; ld.param.u64 %capacity,[actual_capacity]; ld.param.u32 %mode,[field_mode]; mov.u32 %e,10500; ld.global.u32 %n,[%cfg]; setp.gt.u32 %p,%n,2163; @%p bra AD_DONE; ld.global.u32 %ndim,[%cfg+48]; setp.gt.u32 %p,%ndim,2147483647; @%p bra AD_DONE; setp.gt.u64 %p,%capacity,2147483647; @%p bra AD_DONE;
 mov.u32 %map,168; setp.eq.u32 %p,%mode,0; @%p bra MAP_READY; mov.u32 %map,188; setp.eq.u32 %p,%mode,1; @%p bra MAP_READY; mov.u32 %map,192; setp.eq.u32 %p,%mode,5; @%p bra MAP_READY; mov.u32 %map,184; setp.eq.u32 %p,%mode,9; @%p bra MAP_READY; mov.u32 %map,216; setp.ne.u32 %p,%mode,101; @%p bra AD_DONE;
