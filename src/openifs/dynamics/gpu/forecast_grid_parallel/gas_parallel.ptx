 st.param.b64 [ma],%rd; st.param.b64 [mb],%rsum; call.uni (math),md2asm_gpu_add_status,(ma,mb); ld.param.b64 %rsum,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 st.param.b64 [ma],%cpd; st.param.b64 [mb],%csum; call.uni (math),md2asm_gpu_add_status,(ma,mb); ld.param.b64 %csum,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
OUTPUT: setp.eq.u64 %p,%cpout,0; @%p bra GAS_OUTPUT; add.u64 %address,%cpout,%offset; st.global.b64 [%address],%csum;
GAS_OUTPUT: setp.eq.u64 %p,%rout,0; @%p bra RATIO_OUTPUT; add.u64 %address,%rout,%offset; st.global.b64 [%address],%rsum;
RATIO_OUTPUT: setp.eq.u64 %p,%kout,0; @%p bra CELL_NEXT;
 st.param.b64 [ma],%rsum; st.param.b64 [mb],%csum; call.uni (math),md2asm_gpu_div_status,(ma,mb); ld.param.b64 %ratio,[math]; ld.param.u32 %raised,[math+8]; or.b32 %flags,%flags,%raised;
 add.u64 %address,%kout,%offset; st.global.b64 [%address],%ratio;
CELL_NEXT: add.u32 %row,%row,32; setp.le.u32 %p,%row,%last; @%p bra CELL;
