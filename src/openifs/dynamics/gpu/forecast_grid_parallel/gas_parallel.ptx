LEVEL: add.u32 %row,%first,%r27_lane;
CELL:
 setp.gt.u32 %r27_skip,%row,%last; @%r27_skip bra R27_END_CELL; sub.u32 %index,%row,1; mul.wide.u32 %cell,%level,%B; cvt.u64.u32 %tmp,%index; add.u64 %cell,%cell,%tmp; shl.b64 %offset,%cell,3; mov.u32 %seen,0; mov.u32 %i,0; add.u64 %descriptor,%cfg,3848; mov.b64 %rsum,%rd; mov.b64 %csum,%cpd;
