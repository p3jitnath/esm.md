 and.b64 %end,%b,%m; setp.ne.u64 %p,%end,0; @%p bra END;
 setp.gt.u64 %p,%b,0x7fffffffffffffff; @%p bra END;
 add.u64 %end,%b,%n; setp.lt.u64 %p,%end,%b; @%p bra END;
 setp.gt.u64 %p,%end,0x7fffffffffffffff; @%p bra END;
 mov.u32 %error,0;
END: st.param.u32 [result],%error; ret;
}
