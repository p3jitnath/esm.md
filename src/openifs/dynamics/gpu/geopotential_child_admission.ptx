 cvt.u64.u32 %tmp,%cols; sub.u64 %tmp,%tmp,1; add.s64 %tmp,%lower,%tmp;
 setp.lt.s64 %p0,%tmp,%lower; @%p0 bra GEO_REFUSE;
 setp.ne.s64 %p0,%tmp,%upper; @%p0 bra GEO_REFUSE;
 mul.wide.u32 %matrixbytes,%rows,%cols; setp.gt.u64 %p0,%matrixbytes,0x0fffffffffffffff; @%p0 bra GEO_REFUSE;
 shl.b64 %matrixbytes,%matrixbytes,3; ld.u64 %matrix,[%desc]; ld.u64 %capacity,[%rec+64];
 st.param.u64 [rb],%matrix;
 st.param.u64 [rn],%matrixbytes;
 st.param.u64 [rc],%capacity;
 st.param.u64 [rm],7;
 st.param.u64 [rp],%phi; st.param.u64 [rpb],%halfbytes;
 st.param.u64 [rf],%phif; st.param.u64 [rfb],%fullbytes;
 st.param.u64 [rs],%scratch; st.param.u64 [rsb],%scratchbytes;
 call.uni (rr),geo_readonly_range,(rb,rn,rc,rm,rp,rpb,rf,rfb,rs,rsb);
 ld.param.u32 %error,[rr]; setp.ne.u32 %p0,%error,0; @%p0 bra GEO_REFUSE;
 mov.u64 %qinput,%scratch; setp.ne.u32 %p0,%zeroends,0; @!%p0 add.u64 %qinput,%qinput,%pitch;
 mov.u32 %error,0; bra ADMIT_DONE;
GEO_METADATA_READY: mov.u32 %error,0; bra ADMIT_DONE;
GEO_REFUSE: mov.u32 %error,11781; bra ADMIT_DONE;
ADMIT_SUCCESS: mov.u32 %error,0; bra ADMIT_DONE;
 mov.u32 %error,0;
ADMIT_DONE: st.param.u32 [admission_result],%error; ret;
}
